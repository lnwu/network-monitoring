#!/bin/sh
# netmonitor - periodic domestic/international connectivity checker

. /lib/functions.sh

DB_DIR=/etc/netmonitor
DB="$DB_DIR/history.db"
INTERVAL=1
RETENTION=7
TIMEOUT=8
CN_HTTP='https://www.baidu.com'
INTL_HTTP='https://www.google.com/generate_204'

normalize_uint() {
	local value fallback
	value=$1
	fallback=$2
	case "$value" in
		'' | *[!0-9]*) printf '%s' "$fallback"; return ;;
	esac
	value=$(printf '%s' "$value" | sed 's/^0*//')
	[ -n "$value" ] || value=0
	case "$value" in
		??????*) printf '%s' "$fallback"; return ;;
	esac
	printf '%s' "$value"
}

clamp_uint() {
	local value min max fallback
	value=$(normalize_uint "$1" "$4")
	min=$2
	max=$3
	[ "$value" -lt "$min" ] 2>/dev/null && value=$min
	[ "$value" -gt "$max" ] 2>/dev/null && value=$max
	printf '%s' "$value"
}

valid_http_target() {
	case "$1" in
		http://* | https://*) return 0 ;;
		*) return 1 ;;
	esac
}

load_config() {
	config_load netmonitor
	config_get INTERVAL main interval "$INTERVAL"
	config_get RETENTION main retention "$RETENTION"
	config_get TIMEOUT main timeout "$TIMEOUT"
	config_get CN_HTTP main cn_http_target "$CN_HTTP"
	config_get INTL_HTTP main intl_http_target "$INTL_HTTP"

	INTERVAL=$(clamp_uint "$INTERVAL" 1 86400 1)
	RETENTION=$(clamp_uint "$RETENTION" 1 366 7)
	TIMEOUT=$(clamp_uint "$TIMEOUT" 2 60 8)
	[ -n "$CN_HTTP" ] || CN_HTTP='https://www.baidu.com'
	[ -n "$INTL_HTTP" ] || INTL_HTTP='https://www.google.com/generate_204'
	valid_http_target "$CN_HTTP" || CN_HTTP='https://www.baidu.com'
	valid_http_target "$INTL_HTTP" || INTL_HTTP='https://www.google.com/generate_204'
}

detect_wan() {
	local dev
	dev=$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)
	[ -n "$dev" ] && echo "$dev"
}

# do_http <url> [bind_iface] [direct] -> "<ok> <code> <time_s>"
do_http() {
	local out code t
	if [ "$3" = "direct" ]; then
		[ -n "$2" ] || { echo '0 0 0'; return; }
		out=$(curl -4 -s -o /dev/null --max-time "$TIMEOUT" --interface "$2" \
			--proxy '' --noproxy '*' -w '%{http_code} %{time_total}' "$1" 2>/dev/null)
	elif [ -n "$2" ]; then
		out=$(curl -4 -s -o /dev/null --max-time "$TIMEOUT" --interface "$2" \
			-w '%{http_code} %{time_total}' "$1" 2>/dev/null)
	else
		out=$(curl -4 -s -o /dev/null --max-time "$TIMEOUT" \
			--proxy '' -w '%{http_code} %{time_total}' "$1" 2>/dev/null)
	fi
	code=${out%% *}
	t=${out##* }
	case "$code" in '' | 000 | *[!0-9]*) code=0; t=0 ;; esac
	case "$t" in '' | *[!0-9.]*) t=0 ;; esac
	local ok=0
	[ "$code" -ge 200 ] && [ "$code" -lt 400 ] && ok=1
	echo "$ok $code $t"
}

init_db() {
	if ! mkdir -p "$DB_DIR"; then
		return 1
	fi
	if ! chmod 700 "$DB_DIR"; then
		return 1
	fi
	if ! sqlite3 "$DB" "CREATE TABLE IF NOT EXISTS samples (
		ts INTEGER PRIMARY KEY,
		sample_interval INTEGER DEFAULT 1,
		cn_http_code INTEGER DEFAULT 0,
		cn_http_time REAL DEFAULT 0,
		cn_ok INTEGER DEFAULT 0,
		intl_http_code INTEGER DEFAULT 0,
		intl_http_time REAL DEFAULT 0,
		intl_ok INTEGER DEFAULT 0,
		cn_direct_http_code INTEGER DEFAULT NULL,
		cn_direct_http_time REAL DEFAULT NULL,
		cn_direct_ok INTEGER DEFAULT NULL,
		intl_direct_http_code INTEGER DEFAULT NULL,
		intl_direct_http_time REAL DEFAULT NULL,
		intl_direct_ok INTEGER DEFAULT NULL
	);"; then
		return 1
	fi
	for column in \
		"cn_direct_http_code:INTEGER" "cn_direct_http_time:REAL" "cn_direct_ok:INTEGER" \
		"intl_direct_http_code:INTEGER" "intl_direct_http_time:REAL" "intl_direct_ok:INTEGER"; do
		name=${column%%:*}
		type=${column#*:}
		if ! sqlite3 "$DB" "SELECT $name FROM samples LIMIT 0;" >/dev/null 2>&1; then
			if ! sqlite3 "$DB" "ALTER TABLE samples ADD COLUMN $name $type DEFAULT NULL;" >/dev/null 2>&1; then
				return 1
			fi
		fi
	done
	if ! sqlite3 "$DB" "SELECT sample_interval FROM samples LIMIT 0;" >/dev/null 2>&1; then
		if ! sqlite3 "$DB" "ALTER TABLE samples ADD COLUMN sample_interval INTEGER DEFAULT 30;" >/dev/null 2>&1; then
			return 1
		fi
	fi
	if ! chmod 600 "$DB"; then
		return 1
	fi
	sqlite3 "$DB" "PRAGMA journal_mode=WAL; PRAGMA busy_timeout=3000;" >/dev/null
}

log() {
	logger -t netmonitor -s "$1"
}

umask 077
if ! init_db; then
	log "database initialization failed"
	exit 1
fi

for dependency in curl sqlite3 jsonfilter; do
	if ! command -v "$dependency" >/dev/null 2>&1; then
		log "missing dependency: $dependency"
		exit 1
	fi
done

WAN_DEV=
last_clean=
prev_state=
db_error_logged=0
WORKDIR=$(mktemp -d /tmp/netmonitor.XXXXXX) || {
	log "cannot create temporary directory"
	exit 1
}
trap 'rm -rf "$WORKDIR"' EXIT
trap 'exit 0' INT TERM

while :; do
	load_config

	ts=$(date +%s)
	mkdir -p "$WORKDIR"
	WAN_DEV=$(detect_wan)

	(
		set -- $(do_http "$CN_HTTP")
		echo "$1 $2 $3" > "$WORKDIR/cn_http"
	) &

	( set -- $(do_http "$INTL_HTTP"); echo "$1 $2 $3" > "$WORKDIR/intl_http" ) &
	( set -- $(do_http "$CN_HTTP" "$WAN_DEV" direct); echo "$1 $2 $3" > "$WORKDIR/cn_direct_http" ) &
	( set -- $(do_http "$INTL_HTTP" "$WAN_DEV" direct); echo "$1 $2 $3" > "$WORKDIR/intl_direct_http" ) &

	wait

	set -- $(cat "$WORKDIR/cn_http" 2>/dev/null)
	cn_http_ok=${1:-0} cn_http_code=${2:-0} cn_http_time=${3:-0}
	cn_ok=$cn_http_ok

	set -- $(cat "$WORKDIR/intl_http" 2>/dev/null)
	intl_http_ok=${1:-0} intl_http_code=${2:-0} intl_http_time=${3:-0}
	intl_ok=$intl_http_ok

	set -- $(cat "$WORKDIR/cn_direct_http" 2>/dev/null)
	cn_direct_http_ok=${1:-0} cn_direct_http_code=${2:-0} cn_direct_http_time=${3:-0}
	cn_direct_ok=$cn_direct_http_ok

	set -- $(cat "$WORKDIR/intl_direct_http" 2>/dev/null)
	intl_direct_http_ok=${1:-0} intl_direct_http_code=${2:-0} intl_direct_http_time=${3:-0}
	intl_direct_ok=$intl_direct_http_ok

	if sqlite3 -cmd ".timeout 3000" "$DB" "INSERT OR REPLACE INTO samples
		(ts, cn_http_code, cn_http_time, cn_ok,
		 intl_http_code, intl_http_time, intl_ok,
		 cn_direct_http_code, cn_direct_http_time, cn_direct_ok,
		 intl_direct_http_code, intl_direct_http_time, intl_direct_ok, sample_interval)
		VALUES
		($ts, $cn_http_code, $cn_http_time, $cn_ok,
		 $intl_http_code, $intl_http_time, $intl_ok,
		 $cn_direct_http_code, $cn_direct_http_time, $cn_direct_ok,
		 $intl_direct_http_code, $intl_direct_http_time, $intl_direct_ok, $INTERVAL);"; then
		db_error_logged=0
	else
		if [ "$db_error_logged" = "0" ]; then
			log "database insert failed"
			db_error_logged=1
		fi
	fi

	today=$(date +%F)
	if [ "$today" != "$last_clean" ]; then
		cutoff=$((ts - RETENTION * 86400))
		if ! sqlite3 -cmd ".timeout 3000" "$DB" "DELETE FROM samples WHERE ts < $cutoff;" >/dev/null; then
			if [ "$db_error_logged" = "0" ]; then
				log "database cleanup failed"
				db_error_logged=1
			fi
		fi
		last_clean=$today
	fi

	state="$cn_ok$intl_ok$cn_direct_ok$intl_direct_ok"
	if [ -z "$prev_state" ] || [ "$state" != "$prev_state" ]; then
		log "ts=$ts cn_ok=$cn_ok (http=$cn_http_code) intl_ok=$intl_ok (http=$intl_http_code) cn_direct_ok=$cn_direct_ok (http=$cn_direct_http_code) intl_direct_ok=$intl_direct_ok (http=$intl_direct_http_code)"
	fi
	prev_state=$state

	sleep "$INTERVAL" &
	wait $!
done
