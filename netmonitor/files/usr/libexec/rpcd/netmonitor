#!/bin/sh
# rpcd plugin for netmonitor

. /lib/functions.sh

DB_DIR=/etc/netmonitor
DB=$DB_DIR/history.db

storage_bytes() {
	local blocks
	blocks=$(du -sk "$DB_DIR" 2>/dev/null | awk 'NR == 1 { print $1 }')
	case "$blocks" in
		'' | *[!0-9]*) blocks=0 ;;
	esac
	echo $((blocks * 1024))
}

normalize_uint() {
	local value fallback
	value=$1
	fallback=$2
	case "$value" in
		'' | *[!0-9]*) printf '%s' "$fallback"; return ;;
	esac
	value=$(printf '%s' "$value" | sed 's/^0*//')
	[ -n "$value" ] || value=0
	case "$value" in
		??????*) printf '%s' "$fallback"; return ;;
	esac
	printf '%s' "$value"
}

load_interval() {
	config_load netmonitor
	config_get INTERVAL main interval 1
	INTERVAL=$(normalize_uint "$INTERVAL" 1)
	[ "$INTERVAL" -lt 1 ] 2>/dev/null && INTERVAL=1
	[ "$INTERVAL" -gt 86400 ] 2>/dev/null && INTERVAL=86400
}

today() {
	date +%F
}

case "$1" in
	list)
		echo '{"status":{},"history":{"date":"str"},"days":{}}'
		exit 0
		;;
	call)
		;;
	*)
		exit 0
		;;
esac

METHOD="$2"
INPUT=''
read -r INPUT || :

case "$METHOD" in
	status)
		storage=$(storage_bytes)
		row=$(sqlite3 -json -cmd ".timeout 3000" "$DB" "SELECT ts, cn_ping, cn_loss, cn_http_code, cn_http_time, cn_ok,
			intl_ping, intl_loss, intl_http_code, intl_http_time, intl_ok,
			direct_http_code, direct_http_time, direct_ok, direct_checked
			FROM samples ORDER BY ts DESC LIMIT 1" 2>/dev/null)
		if [ -n "$row" ]; then
			row=${row#\[}
			row=${row%\]}
			row=${row#\{}
			row=${row%\}}
			printf '{"storage_bytes":%s,%s}\n' "$storage" "$row"
		else
			printf '{"storage_bytes":%s}\n' "$storage"
		fi
		;;

	history)
		DATE=$(printf '%s' "$INPUT" | jsonfilter -e '@.date' 2>/dev/null)
		case "$DATE" in
			[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
			*) DATE=$(today) ;;
		esac
		load_interval
		samples=$(sqlite3 -json -cmd ".timeout 3000" "$DB" "SELECT s.ts, s.cn_ping, s.cn_loss, s.cn_http_code, s.cn_http_time, s.cn_ok,
				sample_interval,
				s.intl_ping, s.intl_loss, s.intl_http_code, s.intl_http_time, s.intl_ok,
				s.direct_http_code, s.direct_http_time, s.direct_ok,
				COALESCE((SELECT p.cn_ok FROM samples p WHERE p.ts < s.ts ORDER BY p.ts DESC LIMIT 1), 1) AS prev_cn_ok,
				COALESCE((SELECT p.intl_ok FROM samples p WHERE p.ts < s.ts ORDER BY p.ts DESC LIMIT 1), 1) AS prev_intl_ok
			FROM samples s
			WHERE s.ts >= strftime('%s', '$DATE 00:00:00', 'utc')
				AND s.ts < strftime('%s', '$DATE 00:00:00', '+1 day', 'utc')
			ORDER BY s.ts" 2>/dev/null)
		[ -n "$samples" ] || samples='[]'
		printf '{"date":"%s","interval":%s,"samples":%s}\n' "$DATE" "$INTERVAL" "$samples"
		;;

	days)
		rows=$(sqlite3 -json -cmd ".timeout 3000" "$DB" "
			WITH t AS (
				SELECT ts,
					date(ts, 'unixepoch', 'localtime') AS day,
					COALESCE(NULLIF(sample_interval, 0), 1) AS sample_interval,
					cn_ok, intl_ok, cn_ping, intl_ping,
					LAG(cn_ok, 1, 1) OVER (ORDER BY ts) AS p_cn,
					LAG(intl_ok, 1, 1) OVER (ORDER BY ts) AS p_intl,
					LEAD(ts) OVER (ORDER BY ts) AS next_ts
				FROM samples
				WHERE ts >= (strftime('%s', 'now') - 370 * 86400)
			)
			SELECT day,
				COUNT(*) AS samples,
				ROUND(AVG(cn_ok) * 100, 1) AS cn_avail,
				ROUND(AVG(intl_ok) * 100, 1) AS intl_avail,
				ROUND(AVG(CASE WHEN cn_ok = 1 AND cn_ping > 0 THEN cn_ping END), 1) AS cn_avg,
				ROUND(MAX(CASE WHEN cn_ok = 1 AND cn_ping > 0 THEN cn_ping END), 1) AS cn_max,
				ROUND(AVG(CASE WHEN intl_ok = 1 AND intl_ping > 0 THEN intl_ping END), 1) AS intl_avg,
				ROUND(MAX(CASE WHEN intl_ok = 1 AND intl_ping > 0 THEN intl_ping END), 1) AS intl_max,
				SUM(1 - cn_ok) AS cn_down,
				SUM(1 - intl_ok) AS intl_down,
				SUM(CASE WHEN cn_ok = 0 AND p_cn = 1 THEN 1 ELSE 0 END) AS cn_outages,
				SUM(CASE WHEN intl_ok = 0 AND p_intl = 1 THEN 1 ELSE 0 END) AS intl_outages,
				SUM(CASE WHEN cn_ok = 0 THEN
					CASE WHEN next_ts IS NULL
						THEN MAX(0, MIN(sample_interval, CAST(strftime('%s', 'now') AS INTEGER) - ts))
						WHEN next_ts <= ts THEN 0
						ELSE MIN(sample_interval, next_ts - ts) END
					ELSE 0 END) AS cn_down_secs,
				SUM(CASE WHEN intl_ok = 0 THEN
					CASE WHEN next_ts IS NULL
						THEN MAX(0, MIN(sample_interval, CAST(strftime('%s', 'now') AS INTEGER) - ts))
						WHEN next_ts <= ts THEN 0
						ELSE MIN(sample_interval, next_ts - ts) END
					ELSE 0 END) AS intl_down_secs
			FROM t
			GROUP BY day
			ORDER BY day DESC
			LIMIT 366" 2>/dev/null)
		[ -n "$rows" ] || rows='[]'
		printf '{"today":"%s","days":%s}\n' "$(today)" "$rows"
		;;

	*)
		echo '{}'
		;;
esac

exit 0
