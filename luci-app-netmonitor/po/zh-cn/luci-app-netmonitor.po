msgid "Network Status"
msgstr "网络状态"

msgid "Realtime Connectivity"
msgstr "实时连通性"

msgid "No data yet. Make sure the netmonitor service is running."
msgstr "暂无数据。请确认 netmonitor 服务已运行。"

msgid "Domestic (%s)"
msgstr "国内 (%s)"

msgid "HTTP status: %s (%ss)"
msgstr "HTTP 状态: %s (%s 秒)"

msgid "HTTP check failed"
msgstr "HTTP 检测失败"

msgid "Ping: %s ms, loss: %s%%"
msgstr "Ping: %s ms, 丢包: %s%%"

msgid "Checked at: %s"
msgstr "检测时间: %s"

msgid "International via proxy"
msgstr "国际（经代理）"

msgid "Ping %s: %s ms, loss: %s%% (ICMP, usually not proxied)"
msgstr "Ping %s: %s ms, 丢包 %s%% (ICMP, 通常不经过代理)"

msgid "International direct (WAN interface reference)"
msgstr "国际直连（WAN 接口参考）"

msgid "May always fail from mainland China; reference only"
msgstr "国内线路下可能始终失败，仅作参考"

msgid "Direct check unavailable"
msgstr "直连检测不可用"

msgid "Broadband / modem link appears DOWN"
msgstr "宽带 / 光猫链路疑似中断"

