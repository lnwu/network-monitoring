msgstr "国内正常，国际中断，但直连正常 —— 代理（OpenClash）可能已失效"

msgid "Domestic OK, international DOWN - proxy or international route issue"
msgstr "国内正常，国际中断 —— 代理或国际路由异常"

msgid "All connections healthy"
msgstr "全部连接正常"

msgid "Verdict"
msgstr "综合判断"

msgid "Network History"
msgstr "网络历史"

msgid "No samples recorded for %s."
msgstr "%s 暂无检测记录。"

msgid "Domestic availability"
msgstr "国内可用率"

msgid "International availability"
msgstr "国际可用率"

msgid "Domestic latency (avg / max)"
msgstr "国内平均/最大延时（毫秒）"

msgid "International latency (avg / max)"
msgstr "国际平均/最大延时（毫秒）"

msgid "Outages (domestic / international)"
msgstr "中断次数（国内 / 国际）"

msgid "Daily Network Fluctuation"
msgstr "每日网络波动"

