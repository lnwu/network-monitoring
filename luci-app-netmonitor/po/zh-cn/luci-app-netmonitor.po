msgstr "日期"

msgid "Domestic avail."
msgstr "国内可用率"

msgid "Intl. avail."
msgstr "国际可用率"

msgid "Domestic avg/max (ms)"
msgstr "国内平均/最大延时（毫秒）"

msgid "Intl. avg/max (ms)"
msgstr "国际平均/最大延时（毫秒）"

msgid "Outages (domestic)"
msgstr "中断次数（国内）"

msgid "Outages (intl.)"
msgstr "中断次数（国际）"

msgid "All Recorded Days"
msgstr "全部记录日期"

msgid "No recorded days yet."
msgstr "暂无记录日期。"

msgid "History data disk usage: %s"
msgstr "历史数据占用磁盘空间：%s"

msgid "Domestic"
msgstr "国内"

msgid "International"
msgstr "国际"

msgid "Outage"
msgstr "中断"

msgid "Network Monitor Settings"
msgstr "网络监控设置"

msgid "Targets and timing for the connectivity monitor. Changes take effect on the next check cycle."
msgstr "连通性监控的目标与检测间隔。修改将在下一轮检测生效。"

msgid "General"
msgstr "常规"

msgid "Check interval (seconds)"
msgstr "检测间隔（秒）"

msgid "Data retention (days)"
msgstr "数据保留（天）"

msgid "Ping count per check"
msgstr "每轮 Ping 次数"

msgid "HTTP timeout (seconds)"
msgstr "HTTP 超时（秒）"

msgid "Log every check cycle"
msgstr "记录每轮检测日志"

msgid "When disabled, only state changes are written to the system log."
msgstr "关闭后仅状态变化写入系统日志。"

msgid "Domestic HTTP target"
msgstr "国内 HTTP 目标"

msgid "Domestic ping target"
msgstr "国内 Ping 目标"

msgid "International HTTP target (via proxy)"
msgstr "国际 HTTP 目标（经代理）"

msgid "International ping target (IP, usually not proxied)"
msgstr "国际 Ping 目标（IP，通常不经过代理）"

msgid "Enable direct international reference check"
msgstr "启用国际直连参考检测"

msgid "Tries to reach an international target by binding to the WAN interface. This does not guarantee bypassing transparent proxies. From mainland China this may always fail depending on the line; useful as a reference only."
msgstr "通过绑定 WAN 接口访问国际目标，但不保证绕过透明代理。国内线路下可能始终失败，仅作参考。"

msgid "Direct check HTTP target"
msgstr "直连检测 HTTP 目标"

msgid "WAN interface for direct check"
msgstr "直连检测的 WAN 接口"

msgid "Leave as \"auto\" to detect automatically (e.g. pppoe-wan)."
msgstr "保留 \"auto\" 自动检测（如 pppoe-wan）。"

