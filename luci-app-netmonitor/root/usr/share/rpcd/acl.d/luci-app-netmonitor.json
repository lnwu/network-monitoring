{
	"luci-app-netmonitor": {
		"description": "Grant UCI and ubus access for luci-app-netmonitor",
		"read": {
			"ubus": {
				"netmonitor": [ "status", "history", "days" ]
			},
			"uci": [ "netmonitor" ]
		},
		"write": {
			"ubus": {
				"netmonitor": [ "clear" ]
			},
			"uci": [ "netmonitor" ]
		}
	}
}
